{
  "name": "promptshield",
  "version": "1.0.0",
  "bin": {
    "promptshield": "./bin/promptshield"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "npm run build && jest",
    "test:coverage": "npm run build && jest --coverage",
    "test:watch": "npm run build && jest --watch",
    "test:integration": "npm run build && jest --testPathPattern=integration",
    "test:performance": "npm run build && jest --testPathPattern=performance",
    "test:parallel": "npm run build && jest --maxWorkers=2",
    "test:parallel:coverage": "npm run build && jest --maxWorkers=2 --coverage",
    "test:parallel:verbose": "npm run build && jest --maxWorkers=2 --verbose",
    "test:parallel:fast": "npm run build && jest --maxWorkers=2 --bail",
    "test:parallel:low": "npm run build && jest --maxWorkers=1",
    "test:parallel:medium": "npm run build && jest --maxWorkers=25%",
    "test:parallel:high": "npm run build && jest --maxWorkers=50%",
    "test:unit": "npm run build && jest --testPathPattern=unit",
    "test:cli": "npm run build && node scripts/cli-test-runner.js",
    "test:cli:parallel": "npm run build && node scripts/cli-test-runner.js --workers=4",
    "test:cli:verbose": "npm run build && node scripts/cli-test-runner.js --verbose",
    "test:all": "npm run build && npm run test:parallel && npm run test:cli",
    "test:comprehensive": "npm run build && jest --maxWorkers=2 --coverage && npm run test:cli",
    "test:comprehensive:verbose": "npm run build && jest --maxWorkers=2 --verbose --coverage && npm run test:cli:verbose",
    "test:comprehensive:fast": "npm run build && jest --maxWorkers=2 --bail && npm run test:cli",
    "test:comprehensive:low": "npm run build && jest --maxWorkers=1 --coverage && npm run test:cli",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "dev": "ts-node src/cli/index.ts",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:clean": "npm cache clean --force && rm -rf node_modules && npm install",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run security:audit",
    "validate:output": "node scripts/validate-output.js",
    "prepublishOnly": "npm run validate && npm run test:coverage",
    "ci": "npm run validate && npm run test:coverage",
    "prepare": "npm run build"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/stream-json": "^1.7.8",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^29.4.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "stream-json": "^1.9.1",
    "zod": "^4.0.5"
  }
}
